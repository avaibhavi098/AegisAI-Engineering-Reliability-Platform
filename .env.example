# ==============================================================================
# AegisAI Environment Variable Template
# ==============================================================================
# Copy this file to .env or inject these variables in your deployment environment.
# DO NOT commit actual secrets or production keys to version control.

# Google Gemini API key used server-side for AI Root-Cause Analysis,
# automated incident triage, runbook generation, and log diagnostics.
# (Available from https://aistudio.google.com/)
GEMINI_API_KEY=

# Public base URL where the application is accessible.
APP_URL=

# Port for the Node.js Express server (defaults to 3000).
PORT=

# Runtime environment (production, development, or test).
NODE_ENV=

# PostgreSQL connection string for production deployment (required in production).
# Example: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=
# File path to the SQLite persistence database file (used for local development if DATABASE_URL is not set).
DATABASE_PATH=./data/aegisai.db

# Custom initial password override for seeded demo accounts (optional).
DEMO_USER_PASSWORD=
